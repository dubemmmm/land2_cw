# Admin login. In production all three are required: without ADMIN_EMAIL and
# ADMIN_PASSWORD there is no admin account, and without AUTH_SECRET nobody can sign in.
ADMIN_EMAIL=admin@cwrealestate.local
ADMIN_PASSWORD=admin123
AUTH_SECRET=replace-with-a-long-random-secret

# Customer and agent accounts. Locally this is a file. On Vercel use a Turso
# database: ACCOUNTS_DB_URL=libsql://<name>.turso.io and its token.
ACCOUNTS_DB_URL=file:./data/accounts.db
ACCOUNTS_DB_TOKEN=

# Email (confirm address, reset password). Without RESEND_API_KEY the emails are
# printed in the server log instead of being sent.
RESEND_API_KEY=
MAIL_FROM=Squaremeter by CW <no-reply@cwlagos.com>

# Public address of the site, used for links in emails. Example: https://squaremeter.cwlagos.com
APP_URL=

# Optional local database path. Vercel uses /tmp automatically unless this is set.
SQLITE_DB_PATH=./data/app.db
