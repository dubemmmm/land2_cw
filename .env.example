# Admin login. In production all three are required: without ADMIN_EMAIL and
# ADMIN_PASSWORD there is no admin account, and without AUTH_SECRET nobody can sign in.
ADMIN_EMAIL=admin@cwrealestate.local
ADMIN_PASSWORD=admin123
AUTH_SECRET=replace-with-a-long-random-secret

# Customer and agent accounts. Locally this is a SQLite file. On Vercel use the
# AWS RDS PostgreSQL database: ACCOUNTS_DB_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
# Optional: ACCOUNTS_DB_CA holds the RDS certificate bundle (PEM) to verify the server.
ACCOUNTS_DB_URL=file:./data/accounts.db
ACCOUNTS_DB_CA=

# Email (confirm address, reset password). Without RESEND_API_KEY the emails are
# printed in the server log instead of being sent.
RESEND_API_KEY=
MAIL_FROM=Squaremeter by CW <no-reply@cwlagos.com>

# Public address of the site, used for links in emails. Leave empty for local work.
# Change it when the site moves to its main domain.
APP_URL=https://land2-cw.vercel.app

# Listings, locations, reports and market data.
# In production set APP_DB_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME (AWS RDS).
# Left empty, the app uses the accounts database when ACCOUNTS_DB_URL is PostgreSQL,
# so one RDS database can hold both. With neither, it falls back to a SQLite file:
# SQLITE_DB_PATH locally, and a temporary file on Vercel that is lost on restart.
APP_DB_URL=
SQLITE_DB_PATH=./data/app.db

# Listings priced in US dollars are shown in naira at the day's rate from
# open.er-api.com. This rate is used only if that service has never answered.
USD_NGN_FALLBACK=1350

# Listing photos are uploaded to this S3 bucket (public read on listings/*).
# Without these four, photos are not accepted. Vercel reserves the AWS_* names,
# so the app uses its own.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
